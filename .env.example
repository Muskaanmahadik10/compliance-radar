# Copy to .env. Defaults run fully offline: RADAR_MODE=local and RADAR_LLM_PROVIDER=mock need no services and no keys.
RADAR_MODE=local                      # local | compose
RADAR_LLM_PROVIDER=mock               # mock | openai_compatible | anthropic
RADAR_LLM_BASE_URL=https://api.groq.com/openai/v1
RADAR_LLM_API_KEY=
RADAR_ANTHROPIC_API_KEY=
RADAR_CHEAP_MODEL=openai/gpt-oss-20b
RADAR_STRONG_MODEL=openai/gpt-oss-120b
# Retrieval models (fastembed, ONNX on CPU). Multilingual demo: BAAI/bge-m3 and BAAI/bge-reranker-v2-m3
RADAR_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RADAR_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Observability (optional): self-hosted Langfuse from docker-compose
RADAR_LANGFUSE_PUBLIC_KEY=
RADAR_LANGFUSE_SECRET_KEY=
RADAR_LANGFUSE_HOST=http://localhost:3000
# Prompt + output budget must fit the provider per-request token limit (Groq free tier: 8000 TPM)
RADAR_MAX_OUTPUT_TOKENS=3000
# Optional fine-tuned classifier tier (needs requirements-lora.txt). Empty = off.
RADAR_CLASSIFIER_MODEL=
RADAR_CLASSIFIER_LORA_MIN_CONFIDENCE=0.8
# Erasure certificate signing key. Empty = public demo key, and certificates are labelled as demo-signed.
RADAR_SIGNING_KEY=
